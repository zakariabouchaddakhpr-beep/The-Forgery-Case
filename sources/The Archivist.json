    {
      "parameters": {
        "jsCode": "const CONFIDENCE_THRESHOLD = 1.2;\n// Calibrated from real test queries: a genuine match scored ~0.95,\n// a query with no real answer in the archive scored ~1.59-1.64 across\n// every result. Lower score = better match (squared L2 distance).\n\nconst items = $input.all();\n\nconst confident = items\n  .filter(item => item.json.score < CONFIDENCE_THRESHOLD)\n  .map(item => ({\n    title: item.json.document.metadata.title,\n    date: item.json.document.metadata.date,\n    museum: item.json.document.metadata.museum,\n    quote: item.json.document.pageContent,\n    score: item.json.score,\n  }));\n\nconst status = confident.length > 0 ? \"grounded\" : \"insufficient_evidence\";\n\nreturn [{\n  json: {\n    status: status,\n    sources: confident,\n    caveats: confident.length < items.length\n      ? [`${items.length - confident.length} additional weak/uncertain match(es) excluded (score >= ${CONFIDENCE_THRESHOLD}).`]\n      : [],\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
