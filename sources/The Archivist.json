    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst data = items[0].json;\n\nconst sourcesText = data.sources.map(s => {\n  const ref = s.date ? `${s.title} (${s.date})` : s.title;\n  return `- [${ref}]: \"${s.quote}\"`;\n}).join(\"\\n\");\n\nconst originalQuery = $('Webhook').item.json.body.query;\nconst userMessage = `Question: ${originalQuery}\\n\\nSources found in the archive:\\n${sourcesText}`;\n\nreturn [{\n  json: {\n    ...data,\n    llm_prompt: userMessage,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1776,
        96
      ],
      "id": "efcc945d-9d93-4237-8d3d-8004693f7314",
