    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-20b\",\n  \"max_tokens\": 1000,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are the Archivist, an expert in historical documents and provenance research for an art-authentication investigation.\\n\\nHard rules, no exceptions:\\n- Answer using ONLY the sources provided to you in this message. Never use outside knowledge about art history, forgeries, or any painting.\\n- Every claim you make must be attributable to one of the given sources. Cite each source by its title and date when you use it.\\n- Do not speculate about whether the painting is authentic or forged. You report what documents say; you do not render a verdict.\\n- Keep your answer to 2-4 sentences, in a measured, archival tone.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ JSON.stringify($json.llm_prompt).slice(1, -1) }}\"\n    }\n  ]\n}",
        "options": {}
      },
